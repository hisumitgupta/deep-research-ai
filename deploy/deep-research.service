[Unit]
Description=Deep Research AI Streamlit App
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/deep_research
EnvironmentFile=/home/ubuntu/deep_research/.env
ExecStart=/home/ubuntu/deep_research/.venv/bin/python -m streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
